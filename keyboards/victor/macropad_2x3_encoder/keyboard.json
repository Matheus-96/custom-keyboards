{
    "manufacturer": "Victor Matheus",
    "keyboard_name": "victor/macropad_2x3_encoder",
    "maintainer": "Victor Matheus",
    "development_board": "promicro_rp2040",
    "bootloader": "rp2040",
    "processor": "RP2040",
    "bootmagic": {
        "matrix": [1, 0]
    },
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "encoder": true
    },
    "matrix_pins": {
        "direct": [
            ["GP0", "GP1", "GP2"],
            ["GP3", "GP4", "GP5"]
        ]
    },
    "encoder": {
        "rotary": [{
            "pin_a": "GP6",
            "pin_b": "GP7"
        }]
    },
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_1": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1}
            ]
        }
    }
}